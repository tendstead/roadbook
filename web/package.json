{
  "name": "roadbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node ../scripts/licenses.mjs && vite build",
    "check": "node ../scripts/licenses.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tendstead/ui": "0.1.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "typescript": "^6.0.0",
    "svelte-check": "^4.0.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.63.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
