# Planning template: requires a future released image and implemented contracts.
name: roadbook
services:
  app:
    image: ${ROADBOOK_IMAGE:?Set a released ghcr.io/tendstead/roadbook version or digest}
    ports: ["${LISTEN_ADDR:-127.0.0.1}:${PORT:-8082}:8080"]
    cpus: 1
    mem_limit: 128m
    memswap_limit: 128m
    environment:
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USERNAME: roadbook
      DB_NAME: roadbook
      DB_PASSWORD: ${DB_PASSWORD:?Set a unique Roadbook database password}
      DB_SSL_MODE: disable
      GOMEMLIMIT: 96MiB
      GOMAXPROCS: "1"
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    depends_on:
      postgres: {condition: service_healthy}
    healthcheck:
      test: [CMD, /app/roadbook, -healthcheck]
      interval: 15s
      timeout: 3s
      retries: 3
  postgres:
    image: postgres:18-alpine
    cpus: 1
    mem_limit: 512m
    memswap_limit: 512m
    environment:
      POSTGRES_USER: roadbook
      POSTGRES_DB: roadbook
      POSTGRES_PASSWORD: ${DB_PASSWORD:?Set a unique Roadbook database password}
    volumes: ["postgres-data:/var/lib/postgresql"]
    healthcheck:
      test: [CMD-SHELL, "pg_isready -U roadbook -d roadbook"]
      interval: 2s
      timeout: 3s
      retries: 20
    restart: unless-stopped
volumes:
  postgres-data:
